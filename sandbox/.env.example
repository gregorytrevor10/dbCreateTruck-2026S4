# Connection defaults for the local database.
#
# Copy to .env and change what you need. .env is gitignored: never commit a real
# password or a real host.

PGUSER=trk
PGPASSWORD=trk
PGDATABASE=trk

# 5433 keeps out of the way of a Postgres already running on 5432.
PGPORT=5433

# Browser address of the console.
UI_PORT=8099

# The seed uses current_date, so set a zone and keep it.
TZ=Australia/Sydney
