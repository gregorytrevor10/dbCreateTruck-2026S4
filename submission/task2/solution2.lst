SELECT d.ENUM,

       d.LNUM,

       d.totalTripMade AS stored,

       (SELECT count(*) FROM TRIP t WHERE t.LNUM = d.LNUM) AS actual

  FROM DRIVER d

 ORDER BY d.ENUM;

